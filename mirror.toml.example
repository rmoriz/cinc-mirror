# cinc-mirror example configuration: mirror to GHCR.
#
# Copy this file to mirror.toml (git-ignored, mode 0600) and replace the
# placeholders:
#
#   cp mirror.toml.example mirror.toml && chmod 600 mirror.toml
#
# Credentials are never stored in this file. The `ghcr` target uses
# `auth = "basic"` and reads them from the environment:
#
#   export CINC_MIRROR_GHCR_USER="<github-user>"
#   export CINC_MIRROR_GHCR_PASSWORD="<token with write:packages>"
#
# With the GitHub CLI:
#
#   export CINC_MIRROR_GHCR_USER="$(gh api user --jq .login)"
#   export CINC_MIRROR_GHCR_PASSWORD="$(gh auth token)"
#
# Or copy `.env.example` to `.env` next to this file and put the same names
# there; the binary loads `.env` (or `config.env`) automatically.
#
# `auth = "docker"` remains available for plain `auths` entries in
# `~/.docker/config.json`, but credential helpers such as Docker Desktop's
# `desktop` helper are not run. In GitHub Actions the workflow supplies a
# plain docker config from `GITHUB_TOKEN`, so the CI configuration is separate.
#
# Replace `<owner>` with your GitHub user or organization. New GHCR packages
# are private; make them public once under
# Package settings -> Change package visibility.

state_dir = "~/.local/state/cinc-mirror"
concurrency = 4
upload_concurrency = 2
max_bandwidth = "0"        # global download cap, e.g. "40MiB/s"; 0 = unlimited
transport = ["ftp", "ftps", "https"]
metadata_transport = "https"
min_version = "18"         # default floor for policies without their own floor

[[projects]]
id = "cinc-stable"
project = "cinc"
channel = "stable"
min_version = "19.0.0"
platforms = ["debian", "ubuntu"]
arches = ["amd64", "arm64"]

[projects.platform_versions]
debian = ["12", "13"]

[[projects]]
id = "cinc-auditor"
project = "cinc-auditor"
channel = "stable"
min_version = "7.0.0"
platforms = ["debian", "ubuntu"]
arches = ["amd64", "arm64"]

[[projects]]
id = "omnibus-toolchain"
project = "omnibus-toolchain"
channel = "stable"
all_versions = true
platforms = "*"
arches = "*"

[ledger]
branch = "ledger"
remote = "origin"

# Repository that receives incident issues, as `owner/repo`. Defaults to
# `GITHUB_REPOSITORY` inside GitHub Actions.
# issue_repo = "<owner>/cinc-mirror"

[[targets]]
name = "ghcr"
kind = "oci"
registry = "ghcr.io"
namespace = "<owner>/cinc-mirror"
auth = "basic"

# A second, ordinary target. Enable it and fill in the host or path; the same
# bytes are always fanned out to every enabled target.
#
# [[targets]]
# name = "rsync"
# kind = "rsync"
# url = "ssh://mirror@backup.example.org/srv/cinc-mirror"
# auth = "ssh-key"
# identity_file = "~/.ssh/id_ed25519"
